{
  "name": "gacha-nymi-work-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo de trabalho Gacha Nymi",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:dev-ai": "node --test tests/dev-ai-baseline.test.cjs",
    "audit:list": "node scripts/dev-ai/baseline.cjs --list",
    "audit:fast": "node scripts/dev-ai/baseline.cjs --suite fast",
    "audit:isolation": "node scripts/dev-ai/baseline.cjs --suite isolation",
    "audit:ipc": "node scripts/dev-ai/baseline.cjs --suite ipc",
    "audit:all": "node scripts/dev-ai/baseline.cjs --suite all",
    "test": "node --test tests/dev-ai-baseline.test.cjs tests/dev-ai-visual.test.cjs tests/dev-ai-ast-boundaries.test.cjs tests/dev-ai-boundary-gate.test.cjs",
    "audit:boundaries": "node scripts/dev-ai/boundary-scan.cjs",
    "audit:boundaries:ast": "node scripts/dev-ai/boundary-ast.cjs",
    "audit:boundaries:gate": "node scripts/dev-ai/feature-boundary-gate.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0"
  }
}
