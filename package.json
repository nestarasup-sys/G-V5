{
  "name": "gacha-nymi-work-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo de trabalho Gacha Nymi",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "predev": "node scripts/prepare-app-data.cjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "prepreview": "node scripts/prepare-app-data.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/app-data-migration.test.cjs tests/studio-character-geometry.test.cjs tests/data-platform.test.cjs tests/video-timeline-index.test.cjs tests/video-frame-determinism.test.cjs tests/video-export-library.test.cjs tests/video-export-jobs.test.cjs tests/video-studio-audio-plan.test.cjs tests/video-raw-frame-writer.test.cjs",
    "bench:video-timeline": "node scripts/bench-video-timeline.cjs",
    "test:data-runtime": "node scripts/test-data-runtime.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0"
  }
}
