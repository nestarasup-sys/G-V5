<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GV5.Modules.Customizador.ViewModels"
             x:Class="GV5.Modules.Customizador.Views.CustomizadorView"
             x:DataType="vm:CustomizadorViewModel">
    <Border Background="{DynamicResource Gv5BrushSurface}" BorderBrush="{DynamicResource Gv5BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource Gv5RadiusCard}" Padding="{DynamicResource Gv5SpaceCard}">
        <StackPanel Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
            <TextBlock Text="Área de personagens" FontSize="{DynamicResource Gv5FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Gv5BrushTextPrimary}" />
            <TextBlock Text="{Binding Status}" FontSize="{DynamicResource Gv5FontSizeBody}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Gv5BrushTextSecondary}" />
        </StackPanel>
    </Border>
</UserControl>
