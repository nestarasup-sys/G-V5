<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GV5.App.ViewModels"
        xmlns:fabricadorVm="using:GV5.Modules.Fabricador.ViewModels"
        xmlns:fabricadorViews="using:GV5.Modules.Fabricador.Views"
        xmlns:customizadorVm="using:GV5.Modules.Customizador.ViewModels"
        xmlns:customizadorViews="using:GV5.Modules.Customizador.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="GV5.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="G-V5 Avalonia">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type fabricadorVm:FabricadorViewModel}">
            <fabricadorViews:FabricadorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type customizadorVm:CustomizadorViewModel}">
            <customizadorViews:CustomizadorView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="240,*" Background="#F5F3F8">
        <Border Grid.Column="0" Background="#211B2B" Padding="20">
            <StackPanel Spacing="18">
                <StackPanel Spacing="3" Margin="0,4,0,16">
                    <TextBlock Text="G-V5" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="NOVA ESTRUTURA" FontSize="11" Foreground="#C6B8D8" />
                </StackPanel>
                <Button Content="Fabricador" Command="{Binding NavigateCommand}" CommandParameter="fabricador" HorizontalContentAlignment="Left" />
                <Button Content="Customizador" Command="{Binding NavigateCommand}" CommandParameter="customizador" HorizontalContentAlignment="Left" />
                <TextBlock Text="Studio e demais áreas entram na ordem definida no plano." TextWrapping="Wrap" FontSize="12" Foreground="#C6B8D8" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32">
            <StackPanel Spacing="6" Margin="0,0,0,24">
                <TextBlock Text="{Binding ActiveRoute.Title}" FontSize="28" FontWeight="Bold" Foreground="#2A2233" />
                <TextBlock Text="{Binding ActiveRoute.Description}" FontSize="15" Foreground="#655B6D" />
            </StackPanel>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>

</Window>
