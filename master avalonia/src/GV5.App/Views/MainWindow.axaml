<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GV5.App.ViewModels"
        xmlns:fabricadorVm="using:GV5.Modules.Fabricador.ViewModels"
        xmlns:fabricadorViews="using:GV5.Modules.Fabricador.Views"
        xmlns:customizadorVm="using:GV5.Modules.Customizador.ViewModels"
        xmlns:customizadorViews="using:GV5.Modules.Customizador.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="GV5.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="G-V5 Avalonia">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type fabricadorVm:FabricadorViewModel}">
            <fabricadorViews:FabricadorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type customizadorVm:CustomizadorViewModel}">
            <customizadorViews:CustomizadorView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="240,*" Background="{DynamicResource Gv5BrushCanvas}">
        <Border Grid.Column="0" Background="{DynamicResource Gv5BrushSidebar}" Padding="{DynamicResource Gv5SpaceSidebar}">
            <StackPanel Spacing="18">
                <StackPanel Spacing="3" Margin="0,4,0,16">
                    <TextBlock Text="G-V5" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Gv5BrushOnAccent}" />
                    <TextBlock Text="NOVA ESTRUTURA" FontSize="11" Foreground="{DynamicResource Gv5BrushSidebarMuted}" />
                </StackPanel>
                <Button Classes="g-v5-nav" Content="Fabricador" Command="{Binding NavigateCommand}" CommandParameter="fabricador" HorizontalContentAlignment="Left" />
                <Button Classes="g-v5-nav" Content="Customizador" Command="{Binding NavigateCommand}" CommandParameter="customizador" HorizontalContentAlignment="Left" />
                <TextBlock Text="Studio e demais áreas entram na ordem definida no plano." TextWrapping="Wrap" FontSize="{DynamicResource Gv5FontSizeCaption}" Foreground="{DynamicResource Gv5BrushSidebarMuted}" Margin="{DynamicResource Gv5SpaceNavNote}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="{DynamicResource Gv5SpacePage}">
            <StackPanel Spacing="6" Margin="0,0,0,24">
                <TextBlock Text="{Binding ActiveRoute.Title}" FontSize="{DynamicResource Gv5FontSizeHeading}" FontWeight="Bold" Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                <TextBlock Text="{Binding ActiveRoute.Description}" FontSize="{DynamicResource Gv5FontSizeBody}" Foreground="{DynamicResource Gv5BrushTextSecondary}" />
            </StackPanel>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
            <TextBlock Grid.Row="2"
                       Text="{Binding NavigationError}"
                       IsVisible="{Binding HasNavigationError}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Gv5BrushAccent}"
                       Margin="0,12,0,0" />
        </Grid>
    </Grid>

</Window>
