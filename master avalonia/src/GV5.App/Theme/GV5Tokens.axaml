<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Gv5ColorCanvas">#F5F3F8</Color>
    <Color x:Key="Gv5ColorSidebar">#211B2B</Color>
    <Color x:Key="Gv5ColorSidebarMuted">#C6B8D8</Color>
    <Color x:Key="Gv5ColorSurface">#FFFFFF</Color>
    <Color x:Key="Gv5ColorBorder">#E4DDEA</Color>
    <Color x:Key="Gv5ColorTextPrimary">#2A2233</Color>
    <Color x:Key="Gv5ColorTextSecondary">#655B6D</Color>
    <Color x:Key="Gv5ColorTextMuted">#83778A</Color>
    <Color x:Key="Gv5ColorAccent">#6C4AB6</Color>
    <Color x:Key="Gv5ColorAccentHover">#5B3C9B</Color>
    <Color x:Key="Gv5ColorOnAccent">#FFFFFF</Color>

    <SolidColorBrush x:Key="Gv5BrushCanvas" Color="{StaticResource Gv5ColorCanvas}" />
    <SolidColorBrush x:Key="Gv5BrushSidebar" Color="{StaticResource Gv5ColorSidebar}" />
    <SolidColorBrush x:Key="Gv5BrushSidebarMuted" Color="{StaticResource Gv5ColorSidebarMuted}" />
    <SolidColorBrush x:Key="Gv5BrushSurface" Color="{StaticResource Gv5ColorSurface}" />
    <SolidColorBrush x:Key="Gv5BrushBorder" Color="{StaticResource Gv5ColorBorder}" />
    <SolidColorBrush x:Key="Gv5BrushTextPrimary" Color="{StaticResource Gv5ColorTextPrimary}" />
    <SolidColorBrush x:Key="Gv5BrushTextSecondary" Color="{StaticResource Gv5ColorTextSecondary}" />
    <SolidColorBrush x:Key="Gv5BrushTextMuted" Color="{StaticResource Gv5ColorTextMuted}" />
    <SolidColorBrush x:Key="Gv5BrushAccent" Color="{StaticResource Gv5ColorAccent}" />
    <SolidColorBrush x:Key="Gv5BrushAccentHover" Color="{StaticResource Gv5ColorAccentHover}" />
    <SolidColorBrush x:Key="Gv5BrushOnAccent" Color="{StaticResource Gv5ColorOnAccent}" />

    <Thickness x:Key="Gv5SpaceSidebar">20</Thickness>
    <Thickness x:Key="Gv5SpacePage">32</Thickness>
    <Thickness x:Key="Gv5SpaceCard">28</Thickness>
    <Thickness x:Key="Gv5SpaceNavButton">12,8</Thickness>
    <Thickness x:Key="Gv5SpaceNavNote">0,16,0,0</Thickness>
    <CornerRadius x:Key="Gv5RadiusCard">14</CornerRadius>

    <x:Double x:Key="Gv5FontSizeHeading">28</x:Double>
    <x:Double x:Key="Gv5FontSizeTitle">22</x:Double>
    <x:Double x:Key="Gv5FontSizeBody">15</x:Double>
    <x:Double x:Key="Gv5FontSizeCaption">12</x:Double>
</ResourceDictionary>
