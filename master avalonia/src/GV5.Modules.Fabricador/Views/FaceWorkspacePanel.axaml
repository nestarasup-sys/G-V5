<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GV5.Modules.Fabricador.ViewModels"
             xmlns:views="using:GV5.Modules.Fabricador.Views"
             x:Class="GV5.Modules.Fabricador.Views.FaceWorkspacePanel"
             x:DataType="vm:FaceWorkspaceViewModel"
             DataContextChanged="OnDataContextChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="11" Margin="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Olhos e rosto" FontSize="16" FontWeight="Bold" Foreground="#342E36" />
                <TextBlock Text="Prepare e confira um par de sobrancelhas antes de gravá-lo no catálogo facial."
                           FontSize="12" Foreground="#706872" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ModelRevisionLabel}" FontSize="11" Foreground="#958B96" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="#F6F3F6" BorderBrush="#E3DCE4" BorderThickness="1" CornerRadius="9" Padding="8">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Text="Prévia do rosto no modelo" FontWeight="Bold" Foreground="#342E36" />
                    <TextBlock Grid.Row="1" Text="Clique em um componente para selecioná-lo; arraste para ajustar a posição."
                               FontSize="10" Foreground="#706872" TextWrapping="Wrap" />
                    <Border Grid.Row="2" Height="220" Background="#E9E4EA" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ComposedFacePreviewImage" Stretch="Uniform" Cursor="SizeAll"
                                   PointerPressed="OnComposedPreviewPointerPressed"
                                   PointerMoved="OnComposedPreviewPointerMoved"
                                   PointerReleased="OnComposedPreviewPointerReleased"
                                   PointerCaptureLost="OnComposedPreviewPointerCaptureLost" />
                            <TextBlock Text="{Binding ComposedPreviewPlaceholder}"
                                       IsVisible="{Binding HasComposedPreviewPlaceholder}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" MaxWidth="280" TextAlignment="Center"
                                       TextWrapping="Wrap" FontSize="11" Foreground="#706872" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding ComposedPreviewError}" IsVisible="{Binding HasComposedPreviewError}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330"
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="#B4233C" />
                </Grid>
            </Border>

            <Border Background="#FBFAFB" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="9" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Importar componentes faciais" FontWeight="Bold" Foreground="#342E36" />
                    <TextBlock Text="Escolha o tipo de folha para revisar. O arquivo original é preservado durante a preparação."
                               FontSize="11" Foreground="#706872" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding SheetKinds}"
                              SelectedItem="{Binding SelectedSheetKind, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}"
                              IsEnabled="{Binding CanChangeSheetKind}" />
                    <StackPanel Spacing="4" IsVisible="{Binding IsNoseSheetSelected}">
                        <TextBlock Text="Divisão da folha de nariz" FontSize="10" FontWeight="Bold" Foreground="#706872" />
                        <ComboBox ItemsSource="{Binding NoseSheetModes}"
                                  SelectedItem="{Binding SelectedNoseSheetMode, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding CanChangeNoseMode}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Button Content="Selecionar arquivo da folha" Command="{Binding SelectFaceSheetCommand}"
                                IsEnabled="{Binding CanSelectSheet}" Padding="10,6"
                                Background="#FFF5F8" BorderBrush="#EFCBD8" Foreground="#A84368" />
                        <Button Content="Descartar prévia" Command="{Binding CancelImportCommand}"
                                IsVisible="{Binding HasPreview}" Padding="10,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#F7F3FA" BorderBrush="#DDD2E9" BorderThickness="1" CornerRadius="9" Padding="10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Biblioteca independente de extras" FontWeight="Bold" Foreground="#342E36" />
                            <TextBlock Text="{Binding HeadExtraLibraryCount, StringFormat='Por slot de modelo · {0} item(ns)'}"
                                       FontSize="10" Foreground="#706872" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ Importar" Command="{Binding AddHeadExtraCommand}"
                                IsEnabled="{Binding CanAddHeadExtra}" Padding="10,6"
                                Background="#F0EAF8" BorderBrush="#D8C8EB" Foreground="#704B9A" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding HeadExtraChoices}"
                              SelectedItem="{Binding SelectedHeadExtra, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}"
                              PlaceholderText="Selecione um extra salvo" />
                    <TextBox Text="{Binding HeadExtraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120" PlaceholderText="Nome do extra" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                        <TextBox Text="{Binding HeadExtraX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Posição X" />
                        <TextBox Grid.Column="1" Text="{Binding HeadExtraY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Posição Y" />
                        <TextBox Grid.Row="1" Text="{Binding HeadExtraScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Escala X" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HeadExtraScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Escala Y" />
                        <TextBox Grid.Row="2" Text="{Binding HeadExtraRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rotação em graus" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Escala 0–20 · rotação em graus" FontSize="9"
                                   Foreground="#958B96" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Salvar extra" Command="{Binding SaveSelectedHeadExtraCommand}"
                                IsEnabled="{Binding CanSaveSelectedHeadExtra}" Padding="9,6"
                                Background="#F0EAF8" BorderBrush="#D8C8EB" Foreground="#704B9A" />
                        <Button Content="Restaurar encaixe inicial" Command="{Binding ResetSelectedHeadExtraCommand}"
                                IsEnabled="{Binding CanResetSelectedHeadExtra}" Padding="9,6"
                                Background="#F0EAF8" BorderBrush="#D8C8EB" Foreground="#704B9A" />
                        <Button Content="Adicionar à montagem facial" Command="{Binding AddSelectedHeadExtraToCatalogCommand}"
                                IsEnabled="{Binding CanAddSelectedHeadExtraToCatalog}" Padding="9,6"
                                Background="#FFF5F8" BorderBrush="#EFCBD8" Foreground="#A84368" />
                        <Button Content="Remover da biblioteca" Command="{Binding RemoveSelectedHeadExtraCommand}"
                                IsEnabled="{Binding CanRemoveSelectedHeadExtra}" Padding="9,6"
                                Background="#FFF3F4" BorderBrush="#F0CACA" Foreground="#A33442" />
                    </StackPanel>
                    <TextBlock Text="Após incluir na montagem facial, publique o catálogo para liberar o extra no Customizador."
                               FontSize="10" Foreground="#706872" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="#FAF5F8" BorderBrush="#E6D2DD" BorderThickness="1" CornerRadius="9" Padding="10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Biblioteca de detalhes faciais" FontWeight="Bold" Foreground="#342E36" />
                            <TextBlock Text="{Binding FaceDetailLibraryCount, StringFormat='Por slot de modelo · {0} item(ns)'}"
                                       FontSize="10" Foreground="#706872" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ Importar detalhe" Command="{Binding ImportFaceDetailCommand}"
                                IsEnabled="{Binding CanImportFaceDetail}" Padding="10,6"
                                Background="#FFF0F6" BorderBrush="#E9C8D8" Foreground="#A84368" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding FaceDetailKinds}"
                              SelectedItem="{Binding SelectedFaceDetailKind, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}" />
                    <ComboBox ItemsSource="{Binding FaceDetailChoices}"
                              SelectedItem="{Binding SelectedFaceDetail, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}"
                              PlaceholderText="Selecione um detalhe salvo" />
                    <TextBox Text="{Binding FaceDetailName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120" PlaceholderText="Nome do detalhe" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                        <TextBox Text="{Binding FaceDetailX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Posição X" />
                        <TextBox Grid.Column="1" Text="{Binding FaceDetailY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Posição Y" />
                        <TextBox Grid.Row="1" Text="{Binding FaceDetailScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Escala X" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FaceDetailScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Escala Y" />
                        <TextBox Grid.Row="2" Text="{Binding FaceDetailRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rotação em graus" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Brilhos, blush e sombra facial" FontSize="9"
                                   Foreground="#958B96" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Salvar detalhe" Command="{Binding SaveSelectedFaceDetailCommand}"
                                IsEnabled="{Binding CanSaveSelectedFaceDetail}" Padding="9,6"
                                Background="#F0EAF8" BorderBrush="#D8C8EB" Foreground="#704B9A" />
                        <Button Content="Restaurar encaixe inicial" Command="{Binding ResetSelectedFaceDetailCommand}"
                                IsEnabled="{Binding CanResetSelectedFaceDetail}" Padding="9,6"
                                Background="#F0EAF8" BorderBrush="#D8C8EB" Foreground="#704B9A" />
                        <Button Content="Adicionar à montagem facial" Command="{Binding AddSelectedFaceDetailToCatalogCommand}"
                                IsEnabled="{Binding CanAddSelectedFaceDetailToCatalog}" Padding="9,6"
                                Background="#FFF5F8" BorderBrush="#EFCBD8" Foreground="#A84368" />
                        <Button Content="Remover da biblioteca" Command="{Binding RemoveSelectedFaceDetailCommand}"
                                IsEnabled="{Binding CanRemoveSelectedFaceDetail}" Padding="9,6"
                                Background="#FFF3F4" BorderBrush="#F0CACA" Foreground="#A33442" />
                    </StackPanel>
                    <TextBlock Text="Inclua o detalhe no catálogo e publique a revisão facial para usá-lo no Customizador."
                               FontSize="10" Foreground="#706872" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding PreviewSummary}"
                       IsVisible="{Binding HasPreview}" FontSize="10" Foreground="#958B96" TextWrapping="Wrap" />
            <ItemsControl x:Name="FacePiecesControl" IsVisible="{Binding HasPreview}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:FaceSheetPreviewTile">
                        <Border Width="128" Margin="0,0,8,8" Background="#FBFAFB"
                                BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="8" Padding="7">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Bold"
                                           Foreground="#706872" HorizontalAlignment="Center" TextAlignment="Center" />
                                <Border Height="92" Background="#E8E3E8" CornerRadius="5" ClipToBounds="True">
                                    <Image Source="{Binding Bitmap}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Dimensions}" FontSize="9" Foreground="#958B96"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="5" IsVisible="{Binding HasMultipleCatalogs}">
                <TextBlock Text="Catálogo facial de destino" FontSize="11" FontWeight="Bold" Foreground="#706872" />
                <ComboBox ItemsSource="{Binding CatalogChoices}"
                          SelectedItem="{Binding SelectedCatalog, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Label}"
                          PlaceholderText="Selecione o catálogo" />
            </StackPanel>
            <TextBlock Text="{Binding CatalogStatus}" FontSize="11" Foreground="#706872" TextWrapping="Wrap" />
            <Border IsVisible="{Binding HasSavedCatalog}" Background="#FBFAFB" BorderBrush="#EEE9ED"
                    BorderThickness="1" CornerRadius="8" Padding="9">
                <StackPanel Spacing="7">
                    <TextBlock Text="Ajustar encaixe do componente" FontWeight="Bold" Foreground="#342E36" />
                    <ComboBox ItemsSource="{Binding ComponentChoices}"
                              SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding ComponentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="120" PlaceholderText="Nome do componente" />
                        <Button Grid.Column="1" Content="Salvar nome" Command="{Binding ApplyComponentNameCommand}"
                                IsEnabled="{Binding CanApplyComponentName}" Padding="10,6"
                                Background="#F0EAF8" BorderBrush="#D8C8EB" Foreground="#704B9A" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                        <TextBox Text="{Binding ComponentX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Posição X" />
                        <TextBox Grid.Column="1" Text="{Binding ComponentY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Posição Y" />
                        <TextBox Grid.Row="1" Text="{Binding ComponentScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Escala X" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ComponentScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Escala Y" />
                        <TextBox Grid.Row="2" Text="{Binding ComponentRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rotação em graus" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Escala maior que 0 e até 20 · rotação em graus"
                                   FontSize="9" Foreground="#958B96" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <Button Content="Salvar encaixe" Command="{Binding ApplyComponentTransformCommand}"
                            IsEnabled="{Binding CanApplyComponentTransform}" HorizontalAlignment="Left"
                            Padding="10,6" Background="#FFF5F8" BorderBrush="#EFCBD8" Foreground="#A84368" />
                    <Button Content="Remover componente selecionado do catálogo"
                            Command="{Binding RemoveSelectedComponentCommand}"
                            IsEnabled="{Binding CanRemoveSelectedComponent}" HorizontalAlignment="Left"
                            Padding="10,6" Background="#FFF3F4" BorderBrush="#EFCBD8" Foreground="#A84368" />
                    <Button Content="{Binding SelectedVisibilityButtonLabel}"
                            Command="{Binding ToggleSelectedVisibilityCommand}"
                            IsEnabled="{Binding CanToggleSelectedVisibility}" HorizontalAlignment="Left"
                            Padding="10,6" Background="#F0EAF8" BorderBrush="#D8C8EB" Foreground="#704B9A" />
                </StackPanel>
            </Border>
            <Button Content="Salvar par no catálogo facial" Command="{Binding ConfirmImportCommand}"
                    IsEnabled="{Binding CanConfirmImport}" IsVisible="{Binding HasPreview}"
                    Padding="11,7" Background="#C74677" BorderBrush="#C74677" Foreground="#FFFFFF" />
            <Border IsVisible="{Binding HasSavedCatalog}" Background="#FBFAFB" BorderBrush="#EEE9ED"
                    BorderThickness="1" CornerRadius="8" Padding="9">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding PublicationStatus}" FontSize="11" Foreground="#706872" TextWrapping="Wrap" />
                    <Button Content="{Binding PublishButtonLabel}" Command="{Binding PublishCatalogCommand}"
                            IsEnabled="{Binding CanPublishCatalog}" HorizontalAlignment="Left" Padding="10,6"
                            Background="#EEF6F1" BorderBrush="#CDE6D5" Foreground="#337A50" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="11" Foreground="#5D7C6B" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="11" Foreground="#B4233C" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
