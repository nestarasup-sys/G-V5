<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GV5.Modules.Fabricador.Views.FabricatorCanvas"
             x:Name="Root">
    <Border Background="#25232B"
            BorderBrush="{DynamicResource Gv5BrushBorder}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Image x:Name="ModelImage"
                   Source="{Binding Frame, ElementName=Root}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
            <TextBlock x:Name="EmptyMessage"
                       Text="Publique uma folha de imagem para visualizar o modelo"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="24"
                       Foreground="#D7D3DE" />
        </Grid>
    </Border>
</UserControl>
