<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GV5.Modules.Fabricador.Views.FabricatorCanvas"
             x:Name="Root">
    <Border Background="#25232B"
            BorderBrush="{DynamicResource Gv5BrushBorder}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid x:Name="Viewport"
              Background="Transparent"
              ClipToBounds="True"
              PointerPressed="OnPointerPressed"
              PointerMoved="OnPointerMoved"
              PointerReleased="OnPointerReleased"
              PointerWheelChanged="OnPointerWheelChanged">
            <Canvas x:Name="ImageLayer" IsHitTestVisible="False">
                <Image x:Name="ModelImage" Stretch="Fill" />
                <Rectangle x:Name="SelectionOverlay"
                           IsHitTestVisible="False"
                           Stroke="#FF91B9FF"
                           StrokeThickness="2"
                           Fill="#2681B9FF" />
                <Line x:Name="RotationStem"
                      IsHitTestVisible="False"
                      Stroke="#FF91B9FF"
                      StrokeThickness="2" />
                <Ellipse x:Name="RotationHandle"
                         IsHitTestVisible="False"
                         Width="12"
                         Height="12"
                         Fill="#FF91B9FF"
                         Stroke="#FF25232B"
                         StrokeThickness="2" />
                <Rectangle x:Name="ScaleHandle"
                           IsHitTestVisible="False"
                           Width="12"
                           Height="12"
                           Fill="#FFFFD166"
                           Stroke="#FF25232B"
                           StrokeThickness="2" />
            </Canvas>
            <TextBlock x:Name="EmptyMessage"
                       Text="Publique uma folha de imagem para visualizar o modelo"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="24"
                       Foreground="#D7D3DE"
                       IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
