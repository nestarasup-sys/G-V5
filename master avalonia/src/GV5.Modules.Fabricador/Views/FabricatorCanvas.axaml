<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GV5.Modules.Fabricador.Views"
             x:Class="GV5.Modules.Fabricador.Views.FabricatorCanvas"
             x:Name="Root">
    <Border Background="#FDFCFF"
            BorderBrush="{DynamicResource Gv5BrushBorder}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid x:Name="Viewport"
              Background="Transparent"
              ClipToBounds="True"
              PointerPressed="OnPointerPressed"
              PointerMoved="OnPointerMoved"
              PointerReleased="OnPointerReleased"
              PointerWheelChanged="OnPointerWheelChanged">
            <Canvas x:Name="ImageLayer" IsHitTestVisible="False">
                <Image x:Name="ModelImage" Stretch="Fill" />
                <views:FabricatorGridOverlay x:Name="GridOverlay" IsHitTestVisible="False" />
                <Rectangle x:Name="SelectionOverlay"
                           IsHitTestVisible="False"
                           Stroke="#FFE15683"
                           StrokeThickness="2"
                           Fill="#24E15683" />
                <Line x:Name="RotationStem"
                      IsHitTestVisible="False"
                      Stroke="#FFE15683"
                      StrokeThickness="2" />
                <Ellipse x:Name="RotationHandle"
                         IsHitTestVisible="False"
                         Width="12"
                         Height="12"
                         Fill="#FFE15683"
                         Stroke="#FFFFFFFF"
                         StrokeThickness="2" />
                <Rectangle x:Name="ScaleHandle"
                           IsHitTestVisible="False"
                           Width="12"
                           Height="12"
                           Fill="#FFFFD166"
                           Stroke="#FFFFFFFF"
                           StrokeThickness="2" />
                <Canvas x:Name="RigGuideLayer" IsHitTestVisible="False" />
            </Canvas>
            <TextBlock x:Name="EmptyMessage"
                       Text="Publique uma folha de imagem para visualizar o modelo"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="24"
                       Foreground="#AAA1AA"
                       IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
