<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GV5.Modules.Fabricador.ViewModels"
             xmlns:views="using:GV5.Modules.Fabricador.Views"
             xmlns:interaction="using:GV5.Modules.Fabricador.Interaction"
             x:Class="GV5.Modules.Fabricador.Views.FabricadorView"
             x:DataType="vm:FabricadorViewModel"
             DataContextChanged="OnDataContextChanged">
    <Border Background="#FFFFFF"
            BorderBrush="#EDE8EC"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid RowDefinitions="76,60,*">
            <Border Grid.Row="0"
                    Background="#FDFBFC"
                    BorderBrush="#F0EBEF"
                    BorderThickness="0,0,0,1"
                    Padding="12,9">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="30" Height="30" CornerRadius="9" Background="#FFF1F6" VerticalAlignment="Center">
                        <TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C74677" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Width="118" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Modelos" FontSize="12" FontWeight="Bold" Foreground="#342E36" />
                            <TextBlock Text="Fabricador" FontSize="12" Foreground="#AAA1AA" />
                        </StackPanel>
                        <TextBox x:Name="ModelNameInput"
                                 Text="{Binding ModelName}"
                                 IsEnabled="{Binding CanEdit}"
                                 IsVisible="{Binding IsModelWorkspace}"
                                 PlaceholderText="Nome do modelo"
                                 MinWidth="180"
                                 MaxWidth="320"
                                 VerticalAlignment="Center"
                                 Padding="9,6" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="＋  Importar folha"
                            Command="{Binding SelectModelSourceCommand}"
                            IsEnabled="{Binding CanSelectModelSource}"
                            IsVisible="{Binding IsModelWorkspace}"
                            VerticalAlignment="Center"
                            Padding="12,8"
                            BorderBrush="#EFCBD8"
                            Background="#FFF5F8"
                            Foreground="#A84368" />
                </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="#F0EBEF" BorderThickness="0,0,0,1" Padding="15,7">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding IsEditorWorkspace}">
                        <Button Content="↶" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Desfazer última edição" Width="31" Height="31" Padding="0" />
                        <Button Content="↷" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Refazer edição desfeita" Width="31" Height="31" Padding="0" />
                        <TextBlock Text="{Binding UndoCount}" MinWidth="28" VerticalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="#958B96" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding IsModelWorkspace}">
                        <RadioButton Content="Selecionar"
                                     GroupName="FabricatorTool"
                                     IsChecked="{Binding IsSelectTool}"
                                     Command="{Binding SetToolCommand}"
                                     CommandParameter="{x:Static interaction:FabricatorTool.Select}" />
                        <RadioButton Content="Mover tela"
                                     GroupName="FabricatorTool"
                                     IsChecked="{Binding IsPanTool}"
                                     Command="{Binding SetToolCommand}"
                                     CommandParameter="{x:Static interaction:FabricatorTool.Pan}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedPartName}"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               Foreground="#706872"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SaveStateText"
                               Grid.Column="3"
                               Text="{Binding SaveStateLabel}"
                               IsVisible="{Binding IsModelWorkspace}"
                               VerticalAlignment="Center"
                               Foreground="#8E898F"
                               Margin="0,0,3,0" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Button Content="{Binding HairWorkspaceButtonLabel}"
                                Command="{Binding ToggleHairWorkspaceCommand}"
                                IsEnabled="{Binding CanToggleHairWorkspace}"
                                IsVisible="{Binding IsModelWorkspace}"
                                Padding="10,6"
                                Background="#F7F0FA"
                                BorderBrush="#E4D4EA"
                                Foreground="#704A82" />
                        <Button Content="Voltar ao modelo"
                                Command="{Binding ToggleHairWorkspaceCommand}"
                                IsVisible="{Binding IsHairWorkspace}"
                                Padding="10,6"
                                Background="#F7F0FA"
                                BorderBrush="#E4D4EA"
                                Foreground="#704A82" />
                        <Button Content="{Binding PoseWorkspaceButtonLabel}"
                                Command="{Binding TogglePoseWorkspaceCommand}"
                                IsEnabled="{Binding CanTogglePoseWorkspace}"
                                IsVisible="{Binding IsNotAnimationWorkspace}"
                                Padding="10,6"
                                Background="#FFF1F6"
                                BorderBrush="#EFCBD8"
                                Foreground="#A84368" />
                        <Button Content="{Binding AnimationWorkspaceButtonLabel}"
                                Command="{Binding ToggleAnimationWorkspaceCommand}"
                                IsEnabled="{Binding CanToggleAnimationWorkspace}"
                                IsVisible="{Binding IsModelWorkspace}"
                                Padding="10,6"
                                Background="#F3F0FF"
                                BorderBrush="#DCD3FF"
                                Foreground="#6450A5" />
                        <Button Content="Voltar ao modelo"
                                Command="{Binding ToggleAnimationWorkspaceCommand}"
                                IsVisible="{Binding IsAnimationWorkspace}"
                                Padding="10,6"
                                Background="#F3F0FF"
                                BorderBrush="#DCD3FF"
                                Foreground="#6450A5" />
                        <Button Content="{Binding PublishRevisionButtonLabel}"
                                Command="{Binding PublishModelRevisionCommand}"
                                IsEnabled="{Binding CanPublishRevision}"
                                IsVisible="{Binding IsModelWorkspace}"
                                Padding="10,6"
                                BorderBrush="#EFCBD8"
                                Foreground="#A84368" />
                        <Button Content="Salvar"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanSave}"
                                IsVisible="{Binding IsModelWorkspace}"
                                Padding="12,6"
                                Background="#C74677"
                                Foreground="#FFFFFF" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="1.7*,1*" ColumnSpacing="11" Margin="11" MinHeight="420">
                <Border Grid.Column="0"
                        BorderBrush="#EEE9ED"
                        BorderThickness="1"
                        CornerRadius="11"
                        Background="#FBFAFB"
                        ClipToBounds="True">
                    <Grid RowDefinitions="32,*,29">
                        <Border Grid.Row="0" Background="#FBFAFB" BorderBrush="#F0EBEF" BorderThickness="0,0,0,1" Padding="11,0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#E786A6" />
                                    <TextBlock Text="{Binding CanvasHeader}" FontSize="12" FontWeight="Bold" LetterSpacing="0.8" Foreground="#A198A2" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CanvasSubtitle}" FontSize="12" Foreground="#A198A2" VerticalAlignment="Center" />
                                <Button x:Name="CanvasGridToggle"
                                        Grid.Column="2"
                                        Content="{Binding CanvasGridButtonLabel}"
                                        Command="{Binding ToggleCanvasGridCommand}"
                                        IsVisible="{Binding IsModelWorkspace}"
                                        Padding="8,3"
                                        FontSize="11"
                                        Background="#F6F0F4"
                                        BorderBrush="#E6D8E1"
                                        Foreground="#795168" />
                            </Grid>
                        </Border>
                        <views:FabricatorCanvas x:Name="ModelCanvas" Grid.Row="1" MinHeight="360" ShowGrid="{Binding CanvasGridEnabled}" />
                        <Border Grid.Row="2" BorderBrush="#EEE9ED" BorderThickness="0,1,0,0" Padding="9,0">
                            <TextBlock Text="{Binding CanvasHelpText}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#A29AA3"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        BorderBrush="#EEE9ED"
                        BorderThickness="1"
                        CornerRadius="11"
                        ClipToBounds="True">
                    <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsModelWorkspace}">
                        <StackPanel Spacing="10" Margin="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Camadas" FontSize="15" FontWeight="Bold" Foreground="#342E36" />
                                <TextBlock Text="O topo da lista fica na frente." FontSize="12" Foreground="#AAA1AA" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Peça selecionada" FontSize="11" Foreground="#AAA1AA" />
                                    <TextBlock Text="{Binding SelectedPartName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#342E36" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Limpar seleção" Command="{Binding ClearSelectionCommand}" Padding="8,5" />
                            </Grid>
                            <ListBox x:Name="ModelPartLayerList"
                                     ItemsSource="{Binding PartLayers}"
                                     MinHeight="100"
                                     MaxHeight="360"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelPartLayerItem">
                                        <Border Background="#FFFFFF" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="7" Padding="5" Margin="0,0,0,3">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                                                <TextBlock Text="●" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" Foreground="#C74677" />
                                                <Button Grid.Column="1"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[views:FabricadorView].DataContext.SelectPartLayerCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Padding="7,5">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding LayerStatus}" FontSize="11" Foreground="#AAA1AA" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Content="↑" ToolTip.Tip="Mover para frente" IsEnabled="{Binding CanMoveForward}" Command="{Binding $parent[views:FabricadorView].DataContext.BringPartForwardCommand}" CommandParameter="{Binding Id}" Padding="7,5" />
                                                <Button Grid.Column="3" Content="↓" ToolTip.Tip="Mover para trás" IsEnabled="{Binding CanMoveBackward}" Command="{Binding $parent[views:FabricadorView].DataContext.SendPartBackwardCommand}" CommandParameter="{Binding Id}" Padding="7,5" />
                                                <Button Grid.Column="4" Content="{Binding VisibilityLabel}" Command="{Binding $parent[views:FabricadorView].DataContext.TogglePartVisibilityCommand}" CommandParameter="{Binding Id}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Mostrar ou ocultar esta peça" Padding="7,5" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Background="#FBFAFB" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="9" Padding="9">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Juntas do rig" FontSize="14" FontWeight="Bold" Foreground="#342E36" />
                                        <TextBlock Text="Conecte peças, ajuste âncoras e escolha juntas fixas ou livres." FontSize="11" Foreground="#AAA1AA" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <ComboBox ItemsSource="{Binding RigPartOptions}"
                                                  SelectedItem="{Binding SelectedRigParent}"
                                                  DisplayMemberBinding="{Binding Name}"
                                                  IsEnabled="{Binding CanEditRig}"
                                                  PlaceholderText="Peça pai" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding RigPartOptions}"
                                                  SelectedItem="{Binding SelectedRigChild}"
                                                  DisplayMemberBinding="{Binding Name}"
                                                  IsEnabled="{Binding CanEditRig}"
                                                  PlaceholderText="Peça filha" />
                                    </Grid>
                                    <Button Content="＋  Conectar peças"
                                            Command="{Binding ConnectRigPartsCommand}"
                                            IsEnabled="{Binding CanEditRig}"
                                            Background="#FFF1F6" BorderBrush="#EFCBD8" Foreground="#A84368" Padding="9,6" />
                                    <ListBox ItemsSource="{Binding RigJointItems}"
                                             SelectedItem="{Binding SelectedRigJoint}"
                                             IsEnabled="{Binding CanEditRig}"
                                             MinHeight="48" MaxHeight="130"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RigJointItem">
                                                <Border Background="#FFFFFF" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,3">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" Foreground="#A84368" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Âncoras da peça pai · X / Y" FontSize="11" Foreground="#706872" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <TextBox Text="{Binding RigParentAnchorX}" PlaceholderText="X" IsEnabled="{Binding CanEditRig}" />
                                        <TextBox Grid.Column="1" Text="{Binding RigParentAnchorY}" PlaceholderText="Y" IsEnabled="{Binding CanEditRig}" />
                                    </Grid>
                                    <TextBlock Text="Âncoras da peça filha · X / Y" FontSize="11" Foreground="#706872" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <TextBox Text="{Binding RigChildAnchorX}" PlaceholderText="X" IsEnabled="{Binding CanEditRig}" />
                                        <TextBox Grid.Column="1" Text="{Binding RigChildAnchorY}" PlaceholderText="Y" IsEnabled="{Binding CanEditRig}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <Button Content="Aplicar âncoras"
                                                Command="{Binding ApplyRigJointAnchorsCommand}"
                                                IsEnabled="{Binding CanEditSelectedRigJoint}"
                                                Padding="8,6" />
                                        <Button Grid.Column="1" Content="{Binding SelectedRigJointModeLabel}"
                                                Command="{Binding ToggleSelectedRigJointModeCommand}"
                                                IsEnabled="{Binding CanEditSelectedRigJoint}"
                                                Padding="8,6" />
                                    </Grid>
                                    <Button Content="Remover junta selecionada"
                                            Command="{Binding RemoveSelectedRigJointCommand}"
                                            IsEnabled="{Binding CanEditSelectedRigJoint}"
                                            Padding="8,6" Foreground="#B4233C" />
                                    <TextBlock Text="Importe uma folha com pelo menos duas peças para editar o rig." IsVisible="{Binding NeedsRigParts}" FontSize="11" Foreground="#AAA1AA" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RigError}" IsVisible="{Binding HasRigError}" TextWrapping="Wrap" Foreground="#B4233C" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding HasPendingRecovery}" Background="#FBFAFB" BorderBrush="#C74677" BorderThickness="1" CornerRadius="9" Padding="10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Rascunho recuperável encontrado" FontWeight="SemiBold" Foreground="#342E36" />
                                    <TextBlock Text="{Binding PendingRecoveryCheckpoint.Name}" FontSize="12" Foreground="#706872" />
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Button Content="Recuperar" Command="{Binding RestoreCheckpointCommand}" Padding="10,6" Background="#C74677" Foreground="#FFFFFF" />
                                        <Button Content="Descartar checkpoint" Command="{Binding DiscardCheckpointCommand}" Padding="10,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Verificando alterações interrompidas…" IsVisible="{Binding IsCheckingRecovery}" FontSize="12" Foreground="#706872" />
                            <TextBlock Text="{Binding RecoveryMessage}" IsVisible="{Binding HasRecoveryMessage}" TextWrapping="Wrap" Foreground="#B4233C" />
                            <Button Content="Selecionar folha de imagem"
                                    Command="{Binding SelectModelSourceCommand}"
                                    IsEnabled="{Binding CanSelectModelSource}"
                                    HorizontalAlignment="Stretch"
                                    Padding="11,8"
                                    Background="#FFF5F8"
                                    BorderBrush="#EFCBD8"
                                    Foreground="#A84368" />
                            <TextBlock Text="Abrindo seletor ou preparando prévia…" IsVisible="{Binding IsImporting}" FontSize="12" Foreground="#706872" />
                            <TextBlock Text="{Binding ImportError}" IsVisible="{Binding HasImportError}" TextWrapping="Wrap" Foreground="#B4233C" />
                            <TextBlock Text="{Binding ImportStatus}" IsVisible="{Binding HasImportStatus}" TextWrapping="Wrap" Foreground="#706872" />
                            <Border IsVisible="{Binding HasImportPreview}" Background="#FFFFFF" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="8" Padding="9">
                                <StackPanel Spacing="8">
                                    <Border Background="#FBFAFB" CornerRadius="6" MinHeight="120" MaxHeight="220">
                                        <Image x:Name="ModelSourcePreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="210" />
                                    </Border>
                                    <TextBlock Text="{Binding ImportPreviewDimensions}" FontSize="12" Foreground="#342E36" />
                                    <TextBlock Text="{Binding ImportPreview.MediaType}" FontSize="12" Foreground="#706872" />
                                    <Border Background="#F8F4F7" BorderBrush="#EEE5EB" BorderThickness="1" CornerRadius="7" Padding="8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding ChromaToleranceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#58424F" />
                                            <Slider x:Name="ModelChromaToleranceSlider"
                                                    Minimum="0"
                                                    Maximum="280"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding ChromaTolerance}"
                                                    IsEnabled="{Binding CanApplyChromaPreview}" />
                                            <TextBlock Text="Ajuste e gere uma prévia. A imagem-fonte original será publicada sem alterações."
                                                       FontSize="11" Foreground="#827783" TextWrapping="Wrap" />
                                            <TextBlock Text="A tolerância mudou; atualize a prévia antes de publicar."
                                                       IsVisible="{Binding IsChromaPreviewStale}"
                                                       FontSize="11" Foreground="#B4233C" TextWrapping="Wrap" />
                                            <Button Content="Atualizar prévia do chroma"
                                                    Command="{Binding ApplyChromaPreviewCommand}"
                                                    IsEnabled="{Binding CanApplyChromaPreview}"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="9,6" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Button Content="Publicar folha" Command="{Binding PublishModelSourceCommand}" IsEnabled="{Binding CanPublishModelSource}" Padding="10,6" Background="#C74677" Foreground="#FFFFFF" />
                                        <Button Content="Cancelar" Command="{Binding CancelModelSourceImportCommand}" IsEnabled="{Binding CanCancelImport}" Padding="10,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SaveErrorText" Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}" TextWrapping="Wrap" Foreground="#B4233C" />
                            <TextBlock Text="{Binding PublishStatus}" IsVisible="{Binding HasPublishStatus}" TextWrapping="Wrap" Foreground="#342E36" />
                            <TextBlock Text="{Binding PublishError}" IsVisible="{Binding HasPublishError}" TextWrapping="Wrap" Foreground="#B4233C" />
                            <TextBlock Text="{Binding PoseEditorError}" IsVisible="{Binding HasPoseEditorError}" TextWrapping="Wrap" Foreground="#B4233C" />
                            <TextBlock Text="{Binding ModelRenderError}" IsVisible="{Binding HasModelRenderError}" TextWrapping="Wrap" Foreground="#B4233C" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsPoseWorkspace}">
                        <StackPanel Spacing="10" Margin="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Editor de poses" FontSize="15" FontWeight="Bold" Foreground="#342E36" />
                                <TextBlock Text="{Binding PoseModelRevisionLabel}" FontSize="12" Foreground="#706872" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Background="#FFF9FB" BorderBrush="#F0D7E1" BorderThickness="1" CornerRadius="8" Padding="9">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Poses salvas" FontWeight="SemiBold" Foreground="#A84368" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                        <TextBox PlaceholderText="Nome da pose" Text="{Binding PoseName}" />
                                        <TextBox Grid.Column="1" PlaceholderText="Categoria (opcional)" Text="{Binding PoseCategory}" />
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                        <Button Content="Nova pose" Command="{Binding CreateNewPoseCommand}" IsEnabled="{Binding CanCreateNewPose}" />
                                        <Button Content="Salvar pose" Command="{Binding SavePoseCommand}" IsEnabled="{Binding CanSavePose}" />
                                        <Button Content="Duplicar" Command="{Binding DuplicatePoseCommand}" IsEnabled="{Binding CanDuplicatePose}" />
                                        <Button Content="Publicar" Command="{Binding PublishPoseCommand}" IsEnabled="{Binding CanPublishPose}" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding SavedPoses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PoseListItem">
                                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,6"
                                                        Command="{Binding $parent[ItemsControl].DataContext.LoadPoseCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="8" Width="270">
                                                        <Border Width="42" Height="42" CornerRadius="5" Background="#F2EBF4" ClipToBounds="True">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Category, TargetNullValue=Sem categoria}" FontSize="11" Foreground="#706872" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding RevisionLabel}" FontSize="11" Foreground="#A84368" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Peças do modelo" FontSize="13" FontWeight="Bold" Foreground="#342E36" />
                                <ListBox ItemsSource="{Binding PosePartItems}"
                                         MinHeight="100"
                                         MaxHeight="260"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModelPartLayerItem">
                                            <Button HorizontalContentAlignment="Left"
                                                    Command="{Binding $parent[views:FabricadorView].DataContext.SelectPosePartCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Padding="8,7"
                                                    Margin="0,0,0,3"
                                                    BorderBrush="#EEE9ED"
                                                    Background="#FFFFFF">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#342E36" />
                                                    <TextBlock Text="{Binding LayerStatus}" FontSize="11" Foreground="#AAA1AA" />
                                                    <TextBlock Text="Peça selecionada" IsVisible="{Binding IsSelected}" FontSize="10" FontWeight="SemiBold" Foreground="#A84368" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <Border Background="#FBFAFB" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="9" Padding="9">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Mover peça" FontWeight="SemiBold" Foreground="#342E36" />
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                                        <Button Grid.Column="1" Content="↑" Command="{Binding NudgePosePartCommand}" CommandParameter="up" IsEnabled="{Binding CanMoveSelectedPosePart}" Width="48" />
                                        <Button Grid.Row="1" Content="←" Command="{Binding NudgePosePartCommand}" CommandParameter="left" IsEnabled="{Binding CanMoveSelectedPosePart}" Width="48" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="5 px" IsEnabled="False" Width="48" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="→" Command="{Binding NudgePosePartCommand}" CommandParameter="right" IsEnabled="{Binding CanMoveSelectedPosePart}" Width="48" />
                                        <Button Grid.Row="2" Grid.Column="1" Content="↓" Command="{Binding NudgePosePartCommand}" CommandParameter="down" IsEnabled="{Binding CanMoveSelectedPosePart}" Width="48" />
                                    </Grid>
                                    <TextBlock Text="As juntas fixas acompanham a peça. Tronco e cabeça não podem ser reposicionados." FontSize="11" Foreground="#706872" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FBFAFB" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="9" Padding="9">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Girar peça" FontWeight="SemiBold" Foreground="#342E36" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                        <Button Content="↶  Girar 15°" Command="{Binding RotatePosePartCommand}" CommandParameter="left" IsEnabled="{Binding CanRotateSelectedPosePart}" Padding="8,7" />
                                        <Button Grid.Column="1" Content="Girar 15°  ↷" Command="{Binding RotatePosePartCommand}" CommandParameter="right" IsEnabled="{Binding CanRotateSelectedPosePart}" Padding="8,7" />
                                    </Grid>
                                    <CheckBox Content="Incluir descendentes de juntas fixas"
                                              IsChecked="{Binding PoseRotateIncludesFixedDescendants}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding PoseEditorStatus}" IsVisible="{Binding IsPoseWorkspace}" TextWrapping="Wrap" FontSize="12" Foreground="#706872" />
                            <TextBlock Text="{Binding PoseEditorError}" IsVisible="{Binding HasPoseEditorError}" TextWrapping="Wrap" FontSize="12" Foreground="#B4233C" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsAnimationWorkspace}">
                        <StackPanel Spacing="10" Margin="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Animador do Fabricador" FontSize="15" FontWeight="Bold" Foreground="#342E36" />
                                <TextBlock Text="{Binding AnimationModelRevisionLabel}" FontSize="12" Foreground="#706872" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AnimationBasePoseLabel}" FontSize="11" Foreground="#6450A5" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Background="#F8F6FF" BorderBrush="#DDD6F4" BorderThickness="1" CornerRadius="8" Padding="9">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Slots de animação" FontWeight="SemiBold" Foreground="#6450A5" />
                                        <TextBlock Grid.Column="1" Text="12 por modelo" FontSize="11" Foreground="#706872" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AnimationSlots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AnimationSlotListItem">
                                                <Button Width="82" Height="62" Padding="4"
                                                        Command="{Binding $parent[ItemsControl].DataContext.SelectAnimationSlotCommand}"
                                                        CommandParameter="{Binding Number}"
                                                        ToolTip.Tip="{Binding Name}">
                                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="70" Height="34" ColumnDefinitions="Auto,*" ColumnSpacing="3">
                                                            <TextBlock Text="{Binding SlotLabel}" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <Image Grid.Column="1" Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="9" MaxWidth="72" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Selecionado" FontSize="8" Foreground="#6450A5" IsVisible="{Binding IsSelected}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Liberar slot selecionado" Command="{Binding ClearAnimationSlotCommand}"
                                            IsEnabled="{Binding CanClearAnimationSlot}" HorizontalAlignment="Left" Padding="8,5" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8F6FF" BorderBrush="#DDD6F4" BorderThickness="1" CornerRadius="8" Padding="9">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Animações salvas" FontWeight="SemiBold" Foreground="#6450A5" />
                                    <TextBox PlaceholderText="Nome da animação" Text="{Binding AnimationName}" IsEnabled="{Binding CanEditAnimation}" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                        <Button Content="Nova animação" Command="{Binding CreateAnimationCommand}" IsEnabled="{Binding CanCreateAnimation}" />
                                        <Button Content="Salvar" Command="{Binding SaveAnimationCommand}" IsEnabled="{Binding CanSaveAnimation}" Background="#7058C9" Foreground="#FFFFFF" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding SavedAnimations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AnimationListItem">
                                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,6"
                                                        Command="{Binding $parent[ItemsControl].DataContext.LoadAnimationCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Width="270">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RevisionLabel}" FontSize="11" Foreground="#6450A5" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Background="#FFFFFF" BorderBrush="#E7E1F5" BorderThickness="1" CornerRadius="7" Padding="8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Criar animação a partir de pose" FontWeight="SemiBold" Foreground="#6450A5" />
                                            <TextBlock Text="Nenhuma pose salva para esta versão do modelo." IsVisible="{Binding HasNoAnimationBasePoses}" FontSize="11" Foreground="#8A8290" />
                                            <ItemsControl ItemsSource="{Binding AnimationBasePoses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AnimationBasePoseListItem">
                                                        <Button HorizontalContentAlignment="Left" Margin="0,0,0,3" Padding="8,6"
                                                                IsEnabled="{Binding $parent[ItemsControl].DataContext.CanCreateAnimationFromPose}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.CreateAnimationFromPoseCommand}"
                                                                CommandParameter="{Binding Id}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Width="260">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Category, TargetNullValue=Sem categoria}" FontSize="10" Foreground="#706872" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding RevisionLabel}" FontSize="11" Foreground="#6450A5" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="#FBFAFB" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="9" Padding="9">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="Quadros-chave" FontWeight="SemiBold" Foreground="#342E36" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Button Content="＋ Quadro" Command="{Binding AddAnimationFrameCommand}" IsEnabled="{Binding CanEditAnimation}" Padding="8,5" />
                                            <Button Content="Excluir" Command="{Binding DeleteAnimationFrameCommand}" IsEnabled="{Binding CanDeleteAnimationFrame}" Padding="8,5" Foreground="#B4233C" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AnimationFrames}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AnimationFrameListItem">
                                                <Button Padding="8,6" MinWidth="80"
                                                        Command="{Binding $parent[ItemsControl].DataContext.SelectAnimationFrameCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding NumberLabel}" FontWeight="Bold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding DurationLabel}" FontSize="10" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Selecionado" IsVisible="{Binding IsSelected}" FontSize="9" Foreground="#6450A5" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="← Mover quadro" Command="{Binding MoveAnimationFrameCommand}" CommandParameter="previous" IsEnabled="{Binding CanEditAnimation}" Padding="8,5" />
                                        <Button Content="Mover quadro →" Command="{Binding MoveAnimationFrameCommand}" CommandParameter="next" IsEnabled="{Binding CanEditAnimation}" Padding="8,5" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <TextBox Text="{Binding AnimationFrameDuration}" IsEnabled="{Binding CanEditAnimation}" PlaceholderText="Duração em ms" />
                                        <TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" Foreground="#706872" />
                                        <Button Grid.Column="2" Content="Aplicar" Command="{Binding ApplyAnimationFrameDurationCommand}" IsEnabled="{Binding CanEditAnimation}" Padding="8,5" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Peças animadas" FontSize="13" FontWeight="Bold" Foreground="#342E36" />
                                <ListBox ItemsSource="{Binding AnimationPartItems}" MinHeight="80" MaxHeight="190" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnimationPartListItem">
                                            <Button HorizontalContentAlignment="Left" Padding="8,6" Margin="0,0,0,3"
                                                    Command="{Binding $parent[views:FabricadorView].DataContext.SelectAnimationPartCommand}"
                                                    CommandParameter="{Binding Id}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Width="270">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding VisibilityLabel}" FontSize="11" Foreground="#706872" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <Border Background="#F8F6FF" BorderBrush="#DDD6F4" BorderThickness="1" CornerRadius="9" Padding="9">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Transformação da peça no quadro" FontWeight="SemiBold" Foreground="#342E36" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <TextBox Text="{Binding AnimationKeyX}" IsEnabled="{Binding CanEditAnimation}" PlaceholderText="Posição X" />
                                        <TextBox Grid.Column="1" Text="{Binding AnimationKeyY}" IsEnabled="{Binding CanEditAnimation}" PlaceholderText="Posição Y" />
                                    </Grid>
                                    <TextBox Text="{Binding AnimationKeyRotation}" IsEnabled="{Binding CanEditAnimation}" PlaceholderText="Rotação em graus" />
                                    <CheckBox Content="Peça visível neste quadro" IsChecked="{Binding AnimationKeyVisible}" IsEnabled="{Binding CanEditAnimation}" />
                                    <Button Content="Aplicar transformação" Command="{Binding ApplyAnimationKeyCommand}" IsEnabled="{Binding CanApplyAnimationKey}" Padding="9,6" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FBFAFB" BorderBrush="#EEE9ED" BorderThickness="1" CornerRadius="9" Padding="9">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Reprodução e interpolação" FontWeight="SemiBold" Foreground="#342E36" />
                                    <ComboBox ItemsSource="{Binding AnimationEasingOptions}" SelectedItem="{Binding SelectedAnimationEasingOption}" DisplayMemberBinding="{Binding Label}" />
                                    <ComboBox ItemsSource="{Binding AnimationLoopModeOptions}" SelectedItem="{Binding SelectedAnimationLoopModeOption}" DisplayMemberBinding="{Binding Label}" />
                                    <TextBlock Text="{Binding AnimationDurationLabel}" FontSize="11" Foreground="#706872" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                        <TextBlock Text="Velocidade" VerticalAlignment="Center" Foreground="#706872" />
                                        <Slider Grid.Column="1" Minimum="0.1" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="False" Value="{Binding AnimationPlaybackSpeed}" />
                                        <TextBlock Grid.Column="2" Text="{Binding AnimationPlaybackSpeed, StringFormat='{}{0:0.0}×'}" VerticalAlignment="Center" Foreground="#706872" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Aplicar parâmetros" Command="{Binding ApplyAnimationSettingsCommand}" IsEnabled="{Binding CanEditAnimation}" Padding="8,5" />
                                        <Button Content="{Binding AnimationPlaybackButtonLabel}" Command="{Binding ToggleAnimationPlaybackCommand}" Padding="8,5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding AnimationEditorStatus}" TextWrapping="Wrap" FontSize="12" Foreground="#706872" />
                            <TextBlock Text="{Binding AnimationEditorError}" IsVisible="{Binding HasAnimationEditorError}" TextWrapping="Wrap" FontSize="12" Foreground="#B4233C" />
                        </StackPanel>
                    </ScrollViewer>
                    <views:HairWorkspacePanel DataContext="{Binding HairWorkspace}"
                                              IsVisible="{Binding $parent[views:FabricadorView].DataContext.IsHairWorkspace}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
