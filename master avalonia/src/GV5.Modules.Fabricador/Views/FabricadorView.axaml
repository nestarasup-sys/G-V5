<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GV5.Modules.Fabricador.ViewModels"
             xmlns:views="using:GV5.Modules.Fabricador.Views"
             xmlns:interaction="using:GV5.Modules.Fabricador.Interaction"
             x:Class="GV5.Modules.Fabricador.Views.FabricadorView"
             x:DataType="vm:FabricadorViewModel"
             DataContextChanged="OnDataContextChanged">
    <Border Background="{DynamicResource Gv5BrushSurface}" BorderBrush="{DynamicResource Gv5BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource Gv5RadiusCard}" Padding="{DynamicResource Gv5SpaceCard}">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch" MaxWidth="1280">
            <StackPanel Spacing="6">
                <TextBlock Text="Novo modelo" FontSize="{DynamicResource Gv5FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                <TextBlock Text="{Binding Status}" FontSize="{DynamicResource Gv5FontSizeBody}" TextWrapping="Wrap" Foreground="{DynamicResource Gv5BrushTextSecondary}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,320" ColumnSpacing="14">
              <StackPanel Grid.Column="0" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="Prévia do modelo"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="↶ Desfazer"
                                Command="{Binding UndoCommand}"
                                ToolTip.Tip="Desfazer última edição"
                                Padding="10,6" />
                        <Button Content="↷ Refazer"
                                Command="{Binding RedoCommand}"
                                ToolTip.Tip="Refazer edição desfeita"
                                Padding="10,6" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton Content="Selecionar"
                                 GroupName="FabricatorTool"
                                 IsChecked="{Binding IsSelectTool}"
                                 Command="{Binding SetToolCommand}"
                                 CommandParameter="{x:Static interaction:FabricatorTool.Select}" />
                    <RadioButton Content="Mover tela"
                                 GroupName="FabricatorTool"
                                 IsChecked="{Binding IsPanTool}"
                                 Command="{Binding SetToolCommand}"
                                 CommandParameter="{x:Static interaction:FabricatorTool.Pan}" />
                    <TextBlock Text="{Binding SelectedPartName}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                </StackPanel>
                <views:FabricatorCanvas x:Name="ModelCanvas" MinHeight="360" MaxHeight="560" />
                <TextBlock Text="{Binding ModelRenderError}"
                           IsVisible="{Binding HasModelRenderError}"
                           TextWrapping="Wrap"
                           Foreground="#B4233C" />
              </StackPanel>
              <Border Grid.Column="1"
                      IsVisible="{Binding HasModelParts}"
                        Background="{DynamicResource Gv5BrushCanvas}"
                        BorderBrush="{DynamicResource Gv5BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Camadas"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                            <TextBlock Text="O topo da lista fica na frente."
                                       FontSize="12"
                                       Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Peça selecionada"
                                           FontSize="11"
                                           Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                                <TextBlock Text="{Binding SelectedPartName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Limpar seleção"
                                    Command="{Binding ClearSelectionCommand}"
                                    Padding="8,5" />
                        </Grid>
                        <ListBox x:Name="ModelPartLayerList"
                                 ItemsSource="{Binding PartLayers}"
                                 MaxHeight="470"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelPartLayerItem">
                                    <Border Background="{DynamicResource Gv5BrushSurface}"
                                            BorderBrush="{DynamicResource Gv5BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="5"
                                            Margin="0,0,0,3">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                                            <TextBlock Text="●"
                                                       IsVisible="{Binding IsSelected}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Gv5BrushAccent}" />
                                            <Button Grid.Column="1"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding $parent[views:FabricadorView].DataContext.SelectPartLayerCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Padding="7,5">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LayerStatus}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Content="↑"
                                                    ToolTip.Tip="Mover para frente"
                                                    IsEnabled="{Binding CanMoveForward}"
                                                    Command="{Binding $parent[views:FabricadorView].DataContext.BringPartForwardCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Padding="7,5" />
                                            <Button Grid.Column="3"
                                                    Content="↓"
                                                    ToolTip.Tip="Mover para trás"
                                                    IsEnabled="{Binding CanMoveBackward}"
                                                    Command="{Binding $parent[views:FabricadorView].DataContext.SendPartBackwardCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Padding="7,5" />
                                            <Button Grid.Column="4"
                                                    Content="{Binding VisibilityLabel}"
                                                    Command="{Binding $parent[views:FabricadorView].DataContext.TogglePartVisibilityCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding CanEdit}"
                                                    ToolTip.Tip="Mostrar ou ocultar esta peça"
                                                    Padding="7,5" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Verificando alterações interrompidas…"
                       IsVisible="{Binding IsCheckingRecovery}"
                       Foreground="{DynamicResource Gv5BrushTextSecondary}" />

            <Border IsVisible="{Binding HasPendingRecovery}"
                    Background="{DynamicResource Gv5BrushCanvas}"
                    BorderBrush="{DynamicResource Gv5BrushAccent}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Rascunho recuperável encontrado"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                    <TextBlock Text="{Binding PendingRecoveryCheckpoint.Name}"
                               FontSize="{DynamicResource Gv5FontSizeBody}"
                               Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Recuperar rascunho"
                                Command="{Binding RestoreCheckpointCommand}"
                                Padding="14,9"
                                Background="{DynamicResource Gv5BrushAccent}"
                                Foreground="{DynamicResource Gv5BrushOnAccent}" />
                        <Button Content="Descartar checkpoint"
                                Command="{Binding DiscardCheckpointCommand}"
                                Padding="14,9" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding RecoveryMessage}"
                       IsVisible="{Binding HasRecoveryMessage}"
                       TextWrapping="Wrap"
                       Foreground="#B4233C" />

            <StackPanel Spacing="8">
                <TextBlock Text="Nome do modelo" FontWeight="SemiBold" Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                <TextBox Text="{Binding ModelName}"
                         IsEnabled="{Binding CanEdit}"
                         PlaceholderText="Ex.: Modelo base"
                         MinHeight="44"
                         FontSize="16"
                         Padding="12,9" />
            </StackPanel>

            <Border Background="{DynamicResource Gv5BrushCanvas}"
                    BorderBrush="{DynamicResource Gv5BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Folha de imagem do modelo"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                        <TextBlock Text="Selecione uma imagem para revisar. Ela só será adicionada aos assets após sua confirmação."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                    </StackPanel>
                    <Button Content="Selecionar folha de imagem"
                            Command="{Binding SelectModelSourceCommand}"
                            IsEnabled="{Binding CanSelectModelSource}"
                            HorizontalAlignment="Left"
                            Padding="16,10"
                            Background="{DynamicResource Gv5BrushAccent}"
                            Foreground="{DynamicResource Gv5BrushOnAccent}" />
                    <TextBlock Text="Abrindo seletor ou preparando prévia…"
                               IsVisible="{Binding IsImporting}"
                               Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                    <TextBlock Text="{Binding ImportError}"
                               IsVisible="{Binding HasImportError}"
                               TextWrapping="Wrap"
                               Foreground="#B4233C" />
                    <TextBlock Text="{Binding ImportStatus}"
                               IsVisible="{Binding HasImportStatus}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                    <Border IsVisible="{Binding HasImportPreview}"
                            Background="{DynamicResource Gv5BrushSurface}"
                            BorderBrush="{DynamicResource Gv5BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <Border Background="{DynamicResource Gv5BrushCanvas}"
                                    CornerRadius="6"
                                    MinHeight="180"
                                    MaxHeight="360">
                                <Image x:Name="ModelSourcePreviewImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MaxWidth="680"
                                       MaxHeight="336" />
                            </Border>
                            <TextBlock Text="{Binding ImportPreviewDimensions}"
                                       Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                            <TextBlock Text="{Binding ImportPreview.MediaType}"
                                       Foreground="{DynamicResource Gv5BrushTextSecondary}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Publicar asset"
                                        Command="{Binding PublishModelSourceCommand}"
                                        IsEnabled="{Binding CanPublishModelSource}"
                                        Padding="16,10"
                                        Background="{DynamicResource Gv5BrushAccent}"
                                        Foreground="{DynamicResource Gv5BrushOnAccent}" />
                                <Button Content="Cancelar"
                                        Command="{Binding CancelModelSourceImportCommand}"
                                        IsEnabled="{Binding CanCancelImport}"
                                        Padding="16,10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource Gv5BrushCanvas}"
                    BorderBrush="{DynamicResource Gv5BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock x:Name="SaveStateText" Text="{Binding SaveStateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                        <TextBlock x:Name="SaveErrorText"
                                   Text="{Binding SaveError}"
                                   IsVisible="{Binding HasSaveError}"
                                   TextWrapping="Wrap"
                                   Foreground="#B4233C" />
                        <TextBlock Text="{Binding PublishStatus}"
                                   IsVisible="{Binding HasPublishStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Gv5BrushTextPrimary}" />
                        <TextBlock Text="{Binding PublishError}"
                                   IsVisible="{Binding HasPublishError}"
                                   TextWrapping="Wrap"
                                   Foreground="#B4233C" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding PublishRevisionButtonLabel}"
                            Command="{Binding PublishModelRevisionCommand}"
                            IsEnabled="{Binding CanPublishRevision}"
                            VerticalAlignment="Center"
                            Padding="18,11"
                            BorderBrush="{DynamicResource Gv5BrushAccent}"
                            Foreground="{DynamicResource Gv5BrushAccent}" />
                    <Button Grid.Column="2"
                            Content="Salvar rascunho"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            VerticalAlignment="Center"
                            Padding="18,11"
                            Background="{DynamicResource Gv5BrushAccent}"
                            Foreground="{DynamicResource Gv5BrushOnAccent}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
